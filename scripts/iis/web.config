<?xml version="1.0" encoding="utf-8"?>
<!--
  PL8TE web app for IIS (Windows 10/11, Windows Server).
  Uses only the IIS features that are switched on by default
  (Static Content, Default Document, HTTP Errors).
  No URL Rewrite module, no Node.js, no ASP.NET needed.
-->
<configuration>
  <system.webServer>
    <!-- The start page. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- Addresses like /settings or /post/123 belong to the app:
         IIS answers them with index.html, and the app shows the right screen. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/index.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Security headers. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=(), payment=()" />
        <add name="Content-Security-Policy" value="frame-ancestors 'none'" />
      </customHeaders>
    </httpProtocol>

    <!-- Browsers always check for a newer index.html (answered with 304 when unchanged). -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
