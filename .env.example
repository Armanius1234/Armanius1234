# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API Keys / Data API
#
# Both values are PUBLIC: they are bundled into the app and anyone can read
# them. Data is protected by Row Level Security in the database, not by
# hiding these values.
#
# NEVER put the secret / service_role key here or anywhere in the app.

# Project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Publishable key (starts with sb_publishable_) or the legacy "anon" key
EXPO_PUBLIC_SUPABASE_KEY=
